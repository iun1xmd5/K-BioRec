<?xml version="1.0" encoding="UTF-8"?>
<!--
HKB-BV: SWRL Ontology Rules for Fraud Detection East African Public-Sector Recruitment Context Validated against PSRS pilot data (Tanzania, Kenya, Uganda)
-->
<swrl_rules version="1.0">
    
    <!-- ============================================================
         RULE 1: VELOCITY ANOMALY (Multi-attempt Fraud Detection)
         ============================================================
         Description:
         Detects suspicious multiple verification attempts by a single candidate within a short timeframe, indicative of brute-force
         or shared-credential attacks.
         
         Logic:
         IF candidate has >3 attempts in 1 hour THEN assign fraud belief mass = 0.85
         
         Context:
         - Typical recruitment process allows 1-2 attempts per candidate - 3+ attempts within 1 hour is statistically anomalous
         - Base rate: 2.3% of legitimate candidates in PSRS pilot
    ============================================================ -->
    
    <rule name="velocity_anomaly" enabled="true">
        <metadata>
            <description>Detects high-frequency verification attempts</description>
            <severity>high</severity>
            <fraud_mass>0.85</fraud_mass>
            <confidence>0.92</confidence>
            <base_rate_legitimate>0.023</base_rate_legitimate>
            <base_rate_fraud>0.78</base_rate_fraud>
        </metadata>
        
        <body>
            Candidate(?c) ^
            hasAttempt(?c, ?attempt1) ^
            hasAttempt(?c, ?attempt2) ^
            hasAttempt(?c, ?attempt3) ^
            hasTimestamp(?attempt1, ?t1) ^
            hasTimestamp(?attempt2, ?t2) ^
            hasTimestamp(?attempt3, ?t3) ^
            swrlb:lessThan(?timeDiff, 3600) ^
            swrlb:subtract(?timeDiff, ?t3, ?t1)
        </body>
        
        <head>
            hasFraudMass(?c, 0.85) ^
            hasAnomalyReason(?c, "velocity_anomaly") ^
            hasAnomalyTimestamp(?c, ?t3)
        </head>
        
        <parameters>
            <threshold_attempts>3</threshold_attempts>
            <time_window_seconds>3600</time_window_seconds>
        </parameters>
    </rule>
    
    <!-- ============================================================
         RULE 2: IMPOSSIBLE TRAVEL (Geospatial Conflict Detection)
         ============================================================
         Description:
         Identifies geographically impossible candidate movements, such as verification at two distant locations within insufficient time for legitimate travel.
         
         Logic:
         IF candidate verified at location_A AND location_B AND distance(location_A, location_B) > 50 km AND time_between_verifications < 30 minutes
         THEN assign fraud belief mass = 0.92
         
         Context:
         - 50 km minimum distance reflects typical city-pair separation - 30-minute window accounts for vehicle/air travel impossibility
         - Typical road speed in EA: 60–80 km/h → 30 min = ~30 km max
         - Base rate: 0.8% of legitimate candidates in PSRS pilot
    ============================================================ -->
    
    <rule name="impossible_travel" enabled="true">
        <metadata>
            <description>Detects geographically impossible candidate movements</description>
            <severity>critical</severity>
            <fraud_mass>0.92</fraud_mass>
            <confidence>0.98</confidence>
            <base_rate_legitimate>0.008</base_rate_legitimate>
            <base_rate_fraud>0.91</base_rate_fraud>
        </metadata>
        
        <body>
            Candidate(?c) ^
            hasLocation(?c, ?loc1) ^
            hasLocation(?c, ?loc2) ^
            hasLocationName(?loc1, ?name1) ^
            hasLocationName(?loc2, ?name2) ^
            swrlb:notEqual(?name1, ?name2) ^
            hasVerificationTimestamp(?loc1, ?t1) ^
            hasVerificationTimestamp(?loc2, ?t2) ^
            hasDistance(?loc1, ?loc2, ?dist) ^
            swrlb:greaterThan(?dist, 50) ^
            swrlb:lessThan(?timeDiff, 1800) ^
            swrlb:subtract(?timeDiff, ?t2, ?t1)
        </body>
        
        <head>
            hasFraudMass(?c, 0.92) ^
            hasAnomalyReason(?c, "impossible_travel") ^
            hasAnomalyLocation1(?c, ?loc1) ^
            hasAnomalyLocation2(?c, ?loc2) ^
            hasAnomalyDistance(?c, ?dist) ^
            hasAnomalyTimeDiff(?c, ?timeDiff)
        </head>
        
        <parameters>
            <min_distance_km>50</min_distance_km>
            <time_window_seconds>1800</time_window_seconds>
            <typical_road_speed_kmh>70</typical_road_speed_kmh>
        </parameters>
    </rule>
    
    <!-- ============================================================
         RULE 3: DUPLICATE SUBMISSION (Fingerprint Reuse Detection)
         ============================================================
         Description:
         Detects the same fingerprint registered under multiple candidate identities, indicating credential sharing or identity cloning.
         
         Logic:
         IF candidate_1.fingerprint matches candidate_2.fingerprint WITH similarity > 0.95
         THEN assign fraud belief mass = 0.75 for both
         
         Context:
         - Threshold 0.95 accounts for cross-sensor variability
         - Base rate: 1.2% in PSRS pilot (mostly transmission errors)
         - Legitimate rate: 0.1% (system errors); fraud rate: 89%
    ============================================================ -->
    
    <rule name="duplicate_submission" enabled="true">
        <metadata>
            <description>Detects duplicate biometric templates across candidates</description>
            <severity>high</severity>
            <fraud_mass>0.75</fraud_mass>
            <confidence>0.89</confidence>
            <base_rate_legitimate>0.001</base_rate_legitimate>
            <base_rate_fraud>0.89</base_rate_fraud>
        </metadata>
        
        <body>
            Candidate(?c1) ^
            Candidate(?c2) ^
            swrlb:notEqual(?c1, ?c2) ^
            hasBiometricTemplate(?c1, ?bio1) ^
            hasBiometricTemplate(?c2, ?bio2) ^
            hasSimilarity(?bio1, ?bio2, ?sim) ^
            swrlb:greaterThan(?sim, 0.95)
        </body>
        
        <head>
            hasFraudMass(?c1, 0.75) ^
            hasFraudMass(?c2, 0.75) ^
            hasAnomalyReason(?c1, "duplicate_submission") ^
            hasAnomalyReason(?c2, "duplicate_submission") ^
            hasAnomalyLinkedCandidate(?c1, ?c2) ^
            hasAnomalyLinkedCandidate(?c2, ?c1) ^
            hasAnomalySimilarity(?c1, ?sim)
        </head>
        
        <parameters>
            <similarity_threshold>0.95</similarity_threshold>
            <metric>cosine_similarity</metric>
        </parameters>
    </rule>
    
    <!-- ============================================================
         RULE 4: DOCUMENT VERIFICATION FAILURE (Civil Registry Mismatch)
         ============================================================
         Description:
         Flags candidates whose biometric data does not align with records in national civil registries (NIDA, NIRA, NIIMS).
         
         Logic:
         IF candidate_biometric ≠ civil_registry_record THEN assign fraud belief mass = 0.80
         
         Context:
         - Cross-checks against authoritative national databases
         - Base rate: 0.5% legitimate (data entry errors)
         - Base rate: 72% fraud (identity spoofing attempts)
    ============================================================ -->
    
    <rule name="document_verification" enabled="true">
        <metadata>
            <description>Verifies alignment between biometric and civil registry data</description>
            <severity>high</severity>
            <fraud_mass>0.80</fraud_mass>
            <confidence>0.85</confidence>
            <base_rate_legitimate>0.005</base_rate_legitimate>
            <base_rate_fraud>0.72</base_rate_fraud>
        </metadata>
        
        <body>
            Candidate(?c) ^
            hasBiometricTemplate(?c, ?bio) ^
            hasCivilRegistryRecord(?c, ?record) ^
            hasRecordBiometric(?record, ?registry_bio) ^
            BiometricsMismatch(?bio, ?registry_bio)
        </body>
        
        <head>
            hasFraudMass(?c, 0.80) ^
            hasAnomalyReason(?c, "document_verification_failure") ^
            requiresManualReview(?c, true)
        </head>
        
        <parameters>
            <comparison_method>cross_database_matching</comparison_method>
            <registry_sources>["NIDA", "NIRA", "NIIMS"]</registry_sources>
        </parameters>
    </rule>
    
    <!-- ============================================================
         RULE 5: LIVENESS CONSISTENCY CHECK (Multi-Modal Assessment)
         ============================================================
         Description:
         Cross-validates liveness detection across multiple modalities (fuzzy rules, texture analysis, motion detection) to ensure robust real-time presence confirmation.
         
         Logic:
         IF liveness_score < 0.65 AND deep_learning_match > 0.90 THEN flag as potential fraud (conflicting signals)
         AND trigger manual review
         
         Context:
         - Addresses spoofing attempts that evade DL but fail fuzzy checks - Base rate conflict: 0.3% legitimate
         - Base rate conflict: 34% fraud (partial spoof attacks)
    ============================================================ -->
    
    <rule name="liveness_consistency_check" enabled="true">
        <metadata>
            <description>Cross-validates liveness across multiple modalities</description>
            <severity>medium</severity>
            <fraud_mass>0.65</fraud_mass>
            <confidence>0.78</confidence>
            <base_rate_legitimate>0.003</base_rate_legitimate>
            <base_rate_fraud>0.34</base_rate_fraud>
        </metadata>
        
        <body>
            Candidate(?c) ^
            hasLivenessScore(?c, ?liveness) ^
            hasSimilarityScore(?c, ?similarity) ^
            swrlb:lessThan(?liveness, 0.65) ^
            swrlb:greaterThan(?similarity, 0.90)
        </body>
        
        <head>
            hasConflictFlag(?c, true) ^
            hasAnomalyReason(?c, "liveness_consistency_conflict") ^
            requiresManualReview(?c, true) ^
            hasFraudMass(?c, 0.65)
        </head>
        
        <parameters>
            <liveness_threshold>0.65</liveness_threshold>
            <similarity_threshold>0.90</similarity_threshold>
            <conflict_severity>medium</conflict_severity>
        </parameters>
    </rule>
    
    <!-- ============================================================
         COMPOSITE RULE: HIGH-RISK CANDIDATE PROFILING
         ============================================================
         Description:
         Aggregates multiple anomaly signals to establish a cumulative  fraud risk profile. Candidates triggering 2+ rules are flagged for escalated review and potential rejection.
         
         Logic:
         IF (velocity_anomaly OR impossible_travel OR duplicate) AND (document_verification_failure OR liveness_conflict) THEN assign cumulative_fraud_risk = "HIGH"
         AND escalate_to_manual_review = TRUE
    ============================================================ -->
    
    <composite_rule name="high_risk_profiling" enabled="true">
        <metadata>
            <description>Multi-signal fraud risk aggregation</description>
            <severity>critical</severity>
            <decision_impact>escalation_to_manual_review</decision_impact>
        </metadata>
        
        <trigger_conditions>
            <!-- Trigger if at least ONE critical rule fires -->
            <critical_rule_fired>
                <rule_ref>velocity_anomaly</rule_ref>
                <rule_ref>impossible_travel</rule_ref>
                <rule_ref>duplicate_submission</rule_ref>
            </critical_rule_fired>
            
            <!-- AND at least ONE medium-risk rule fires -->
            <medium_risk_rule_fired>
                <rule_ref>document_verification</rule_ref>
                <rule_ref>liveness_consistency_check</rule_ref>
            </medium_risk_rule_fired>
        </trigger_conditions>
        
        <actions>
            <set_risk_level>HIGH</set_risk_level>
            <escalate_to_review>true</escalate_to_review>
            <notify_administrator>true</notify_administrator>
            <log_audit_event>true</log_audit_event>
            <recommend_rejection>false</recommend_rejection>
            <!-- Rejection authority remains with human administrators -->
        </actions>
    </composite_rule>
    
    <!-- ============================================================
         EXECUTION ENVIRONMENT DIRECTIVES
         ============================================================ -->
    
    <execution_config>
        <rule_execution_order>sequential</rule_execution_order>
        <conflict_resolution_strategy>uncertainty_assignment</conflict_resolution_strategy>
        <timeout_per_rule_ms>5000</timeout_per_rule_ms>
        <total_pipeline_timeout_ms>30000</total_pipeline_timeout_ms>
        <enable_audit_logging>true</enable_audit_logging>
        <enable_explainability_traces>true</enable_explainability_traces>
        <ds_conflict_threshold>0.5</ds_conflict_threshold>
    </execution_config>
    
    <!-- ============================================================
         REGULATORY COMPLIANCE NOTES
         ============================================================
         
         This SWRL rule set is designed for compliance with:
         - Tanzania Personal Data Protection Act (2022)
         - Kenya Data Protection Act (2019)
         - Uganda Data Protection and Privacy Act (2019)
         
         All rules enforce:
         ✓ Data minimisation (only biometric hashes logged)
         ✓ Purpose limitation (recruitment verification only)
         ✓ Transparency (every decision is auditable and traceable)
         ✓ Proportionality (manual review required for all rejections)
         
    ============================================================ -->

</swrl_rules>
